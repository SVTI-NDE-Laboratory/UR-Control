travel_distance = 0.050
move_speed = 0.020
move_acceleration = 0.100

# Robot → Python signal
write_output_integer_register(42, 0)

# Ensure Python acknowledgement is reset
while read_input_integer_register(42) != 0:
    sync()
end

start_pose = get_actual_tcp_pose()
target_pose = pose_trans(
    start_pose,
    p[0, 0, travel_distance, 0, 0, 0]
)

movel(target_pose, a=move_acceleration, v=move_speed)

# Tell Python that the target was reached
write_output_integer_register(42, 1)

# Wait for Python acknowledgement
while read_input_integer_register(42) == 0:
    sync()
end

movel(start_pose, a=move_acceleration, v=move_speed)

# Clear robot signal
write_output_integer_register(42, 0)