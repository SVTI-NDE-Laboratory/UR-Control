def move_along_test_piece_normal():

  # Current TCP pose in Base coordinates
  startPose = get_actual_tcp_pose()

  # Transform current pose into the Test_Piece feature frame
  poseInPlane = pose_trans(pose_inv(Test_Piece), startPose)

  # Move along the feature Z axis (normal direction)
  poseInPlane[2] = poseInPlane[2] + dz_Max

  # Transform back to Base coordinates
  targetPose = pose_trans(Test_Piece, poseInPlane)

  # Execute the motion
  movel(targetPose, a=1.2, v=0.25)

  # Return to the starting position
  movel(startPose, a=1.2, v=0.25)

end

move_along_test_piece_normal()