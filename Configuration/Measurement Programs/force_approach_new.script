# -------------------------------------------------
# Force approach in initial Tool Z+
#
# Behaviour:
# - Move in force_mode along the Tool Z+ direction captured at start.
# - Stop the approach if 230 N is reached or after 100 mm travel.
# - If force is reached, notify Python and remain in force_mode.
# - Leave force_mode after Python replies with RELEASE or after 10 seconds.
# - Return to the exact starting TCP pose afterwards.
# -------------------------------------------------

# USER SETTINGS
python_ip = "192.168.3.100"
python_port = 50001

target_force = 250.0
force_reached_limit = 230.0

max_travel = 0.1
force_speed_limit = 0.05
contact_timeout = 10.0

return_acc = 0.05
return_speed = 0.1


# -------------------------------------------------
# Shared state for the non-blocking TCP reader
# -------------------------------------------------

global release_requested = False

thread tcp_release_reader():
  while release_requested == False:
    reply = socket_read_line("python_socket", 0.1)

    if reply == "RELEASE":
      global release_requested = True
    end

    sync()
  end
end


# -------------------------------------------------
# Save exact current pose before starting
# -------------------------------------------------

return_pose = get_actual_tcp_pose()

# This fixed pose preserves the original Tool Z+ movement orientation.
force_start_pose = return_pose


# -------------------------------------------------
# Connect before moving; do not make contact without communication
# -------------------------------------------------

socket_connected = socket_open(python_ip, python_port, "python_socket")

if socket_connected == True:

  socket_send_line("CONNECTED", "python_socket")

  # -------------------------------------------------
  # Prepare force mode
  # -------------------------------------------------

  zero_ftsensor()

  task_frame = force_start_pose
  selection_vector = [0, 0, 1, 0, 0, 0]
  wrench = [0, 0, target_force, 0, 0, 0]
  force_type = 2

  # For compliant Z, third value is the speed limit in m/s.
  limits = [0.1, 0.1, force_speed_limit, 0.17, 0.17, 0.17]

  force_reached = False
  travel_limit_reached = False


  # -------------------------------------------------
  # Approach phase
  # Stop when force is reached OR 120 mm travel is reached
  # -------------------------------------------------

  while force_reached == False and travel_limit_reached == False:

    force_mode(task_frame, selection_vector, wrench, force_type, limits)

    current_pose = get_actual_tcp_pose()

    # Current TCP pose relative to starting TCP pose
    relative_pose = pose_trans(pose_inv(force_start_pose), current_pose)

    # Travel along the original Tool Z+ orientation
    z_travel = relative_pose[2]

    current_force = force()

    if current_force >= force_reached_limit:
      force_reached = True
    end

    if z_travel >= max_travel:
      travel_limit_reached = True
    end

    sync()
  end


  # -------------------------------------------------
  # Hold phase
  # Stay in force_mode until Python sends RELEASE or timeout expires
  # -------------------------------------------------

  if force_reached == True:

    socket_send_line("CONTACT", "python_socket")

    reader_handle = run tcp_release_reader()
    hold_time = 0.0
    timed_out = False

    while release_requested == False and timed_out == False:
      force_mode(task_frame, selection_vector, wrench, force_type, limits)

      # get_steptime() is the duration of this controller cycle.
      hold_time = hold_time + get_steptime()

      if hold_time >= contact_timeout:
        timed_out = True
        global release_requested = True
      end

      sync()
    end

    join reader_handle

    if timed_out == True:
      socket_send_line("TIMEOUT", "python_socket")
    else:
      socket_send_line("RELEASED", "python_socket")
    end

  else:
    socket_send_line("NO_CONTACT", "python_socket")
  end


  # -------------------------------------------------
  # End force mode, close TCP, and return
  # -------------------------------------------------

  end_force_mode()
  stopl(0.5)
  socket_close("python_socket")

  # Return to the exact TCP pose from before the force approach
  movel(return_pose, a=return_acc, v=return_speed, r=0)

else:

  popup("Could not connect to Python TCP server at 192.168.3.100:50001. Force approach not started.", title="Python socket error", blocking=True)
  textmsg("PYTHON_SOCKET_CONNECT_FAILED")

end
