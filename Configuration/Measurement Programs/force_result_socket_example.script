def send_force_result_to_python(success):

  pc_ip = "192.168.3.100"
  pc_port = 5060
  socket_name = "force_result_socket"

  socket_open(pc_ip, pc_port, socket_name)

  if success == True:
    socket_send_line("{\"message\":\"force_approach_done\",\"success\":true}", socket_name)
  else:
    socket_send_line("{\"message\":\"force_approach_done\",\"success\":false}", socket_name)
  end

  socket_close(socket_name)
end


