# Stationary force-cycle simulation: timed target reach -> settle -> measure.
# Input floats: 43 = distance [m], 44 = settling [s], 45 = target force [N].
# Input integer 42: 0 before start, 1 when Python completes measurement.
# Output integer 42: 0 = initialized/completed, 1 = ready for measurement.
# Distance and target are read for the shared interface; only timers drive this cycle.

# State index: all operator messages are defined here.
def force_state_message(index):
    if index == 0:
        return "Setting simulation variables"
    elif index == 1:
        return "Simulating target force approach"
    elif index == 2:
        return "Simulated target reached; settling"
    elif index == 3:
        return "Simulation ready; waiting for Python measurement release"
    elif index == 4:
        return "Simulation measurement completed by Python acknowledgement"
    elif index == 5:
        return "Simulation cycle completed"
    else:
        return "Unknown simulation state"
    end
end

# Configuration: the register layout matches the real force cycle.
register = 42
global state_message = force_state_message(0)
global distance_max = read_input_float_register(43)
global settling_time = read_input_float_register(44)
global force_holding = read_input_float_register(45)
global force_reached = False
global force_ready = False
global settling_elapsed = 0.0
simulation_approach_time = 1.0  # Seconds until simulated target reach

# Clear status and wait for a clear release input before starting the timer.
write_output_integer_register(register, 0)
while read_input_integer_register(register) != 0:
    sync()
end

# Simulate reaching the target without issuing any motion or force commands.
approach_elapsed = 0.0
state_message = force_state_message(1)
while approach_elapsed < simulation_approach_time:
    sync()
    approach_elapsed = approach_elapsed + get_steptime()
end
force_reached = True
state_message = force_state_message(2)

# Apply the configured settling delay before reporting measurement readiness.
while settling_elapsed < settling_time:
    sync()
    settling_elapsed = settling_elapsed + get_steptime()
end
force_ready = True
state_message = force_state_message(3)
write_output_integer_register(register, 1)

# Python releases after its timer or acquisition client reports completion.
while read_input_integer_register(register) != 1:
    sync()
end
state_message = force_state_message(4)

# The TCP remains at the starting position throughout this stationary cycle.
write_output_integer_register(register, 0)
state_message = force_state_message(5)
