  global p_end_h_p=p[.603494412994, .454997142607, .990991421367, -1.204625727258, -1.199847911447, -1.199816304459]
  global p_end_h_q=[-2.9313026401330298, -1.3420160165168085, 1.3306746735842905, -3.193534917925538, 6.0895219209044775, -1.497095713867921]
