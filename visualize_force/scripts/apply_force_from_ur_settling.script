# Register-controlled force cycle: approach -> settle -> measure -> return.
# Input integer 42: 0 before start, 1 when Python completes measurement.
# Input floats: 43 = distance limit [m], 44 = settling time [s], 45 = target [N].
# Output integer 42: 0 = initialized/completed, 1 = ready, 2 = limit failure.
# Python times the measurement from readiness; the robot times settling.
# Command/travel: starting TCP Z+. Measured force: absolute current TCP Z.

# State index: all operator messages are defined here.
def force_state_message(index):
    if index == 0:
        return "Setting program variables"
    elif index == 1:
        return "Approaching target Z force"
    elif index == 2:
        return "Target Z force reached; settling"
    elif index == 3:
        return "Force ready; waiting for Python measurement release"
    elif index == 4:
        return "Measurement completed by Python acknowledgement"
    elif index == 5:
        return "Maximum displacement reached"
    elif index == 6:
        return "Target Z-force approach timed out"
    elif index == 7:
        return "Moving back to initial position"
    elif index == 8:
        return "Initial position reached"
    elif index == 9:
        return "Cycle completed"
    else:
        return "Unknown force state"
    end
end

# Adapted from UR Global Competence Center's get_tcp_force_tool.script.
# Rotate force and torque axes using the CURRENT actual TCP orientation.
# Rotation only: no TCP position translation or torque origin shift is applied.
def get_tcp_force_tool():
    force_torque = get_tcp_force()
    force_B = p[force_torque[0], force_torque[1], force_torque[2], 0, 0, 0]
    torque_B = p[force_torque[3], force_torque[4], force_torque[5], 0, 0, 0]
    tcp = get_actual_tcp_pose()
    rotation_BT = p[0, 0, 0, tcp[3], tcp[4], tcp[5]]
    force_T = pose_trans(pose_inv(rotation_BT), force_B)
    torque_T = pose_trans(pose_inv(rotation_BT), torque_B)
    return p[force_T[0], force_T[1], force_T[2], torque_T[0], torque_T[1], torque_T[2]]
end

# ---------- Configuration ----------
register = 42

# Global variables appear with live values in PolyScope's Variables pane.
global state_message = force_state_message(0)
global distance_max = read_input_float_register(43)
global force_holding = read_input_float_register(45)
global settling_time = read_input_float_register(44)  # Delay after first target crossing [s]

global settling_elapsed = 0.0
global force_ready = False  # Settling complete; measurement can start
global force_reached = False  # Target crossed; settling can start
global distance_reached = False
global measured_force_z = 0.0 

# Motion settings: compliant-axis speed limit and target-acquisition deadline.
max_approach_speed = 0.02  # m/s along starting TCP Z+
approach_timeout = 10.0

return_speed = 0.04  # m/s after force mode ends
return_acceleration = 0.100  # m/s^2

# Set status: loop until value is set and reject any remaining acknowledgement from an earlier run.
# Status:
# 0 = initialized / completed
# 1 = settled / ready; waiting for Python acknowledgement
# 2 = distance limit during any force stage or approach timeout before target
write_output_integer_register(register, 0)
while read_input_integer_register(register) != 0:
    sync()
end

# Capture the exact return pose and the fixed force frame.
start_pose = get_actual_tcp_pose()
force_frame = start_pose

# Remove sensor bias while stationary before applying force.
zero_ftsensor()
sleep(0.2)

# Initialize state variables for the approach -> settle -> measure -> return cycle.
measured_force_z_signed = 0.0
approach_timed_out = False
approach_elapsed = 0.0
acknowledged = False
cycle_failed = False

# Enter force mode. The same target and frame remain active through
# approach, settling and measurement, until explicitly ended below.
state_message = force_state_message(1)
force_mode(force_frame, [0, 0, 1, 0, 0, 0], [0, 0, force_holding, 0, 0, 0],
           2, [0.010, 0.010, max_approach_speed, 0.10, 0.10, 0.10])

# Main loop
while (acknowledged == False) and (cycle_failed == False):
    # Get travelled distance along starting TCP Z+ and the current measured force along that same axis.
    current_pose = get_actual_tcp_pose()
    relative_pose = pose_trans(pose_inv(start_pose), current_pose)
    travelled_z = relative_pose[2]

    wrench = get_tcp_force_tool()
    measured_force_z_signed = wrench[2]
    measured_force_z = measured_force_z_signed
    if measured_force_z < 0:
        measured_force_z = -measured_force_z
    end

    # Travel remains bounded during approach, settling AND measurement.
    if travelled_z >= distance_max:
        distance_reached = True
    end

    # Distance reached: failed
    if distance_reached:
        cycle_failed = True
        state_message = force_state_message(5)

    # Target not reached: check for first crossing or approach timeout.
    elif force_reached == False:
        if measured_force_z >= force_holding:
            force_reached = True
            settling_elapsed = 0.0
            state_message = force_state_message(2)
        elif approach_elapsed >= approach_timeout:
            approach_timed_out = True
            cycle_failed = True
            state_message = force_state_message(6)
        else:
            approach_elapsed = approach_elapsed + get_steptime()
        end

    # Force not ready: check for settling completion.
    elif force_ready == False:
        # A fixed delay after the first target crossing; later dips do not reset it.
        settling_elapsed = settling_elapsed + get_steptime()
        if settling_elapsed >= settling_time:
            force_ready = True
            state_message = force_state_message(3)
            write_output_integer_register(register, 1)
        end
    end

    # Acknowledged: wait for Python to complete measurement and release the robot.
    if cycle_failed:
        write_output_integer_register(register, 2)
    elif force_ready:
        if read_input_integer_register(register) == 1:
            acknowledged = True
            state_message = force_state_message(4)
        end
    end

    # Yield one controller step; elapsed counters use that same step duration.
    sync()
end

# Exit force control and stop residual motion before the position-controlled return.
end_force_mode()
stopl(1.0)
sleep(0.1)
state_message = force_state_message(7)

# Move back to the initial pose at a safe speed and acceleration.
movel(start_pose, a=return_acceleration, v=return_speed)
state_message = force_state_message(8)

# Reset the output register to 0 for the next cycle and indicate completion.
write_output_integer_register(register, 0)
state_message = force_state_message(9)
